# ---- LLM ----
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ---- Embeddings ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector Store ----
# Options: faiss | chroma
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./data/faiss_index
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=medusa_docs

# ---- Retrieval / Fallback ----
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.30
FALLBACK_TOP_K=3
FALLBACK_SCORE_THRESHOLD=0.15

# ---- Prompt Versioning ----
PROMPT_STORE_PATH=./app/prompts/versions
DEFAULT_PROMPT_VERSION=v1

# ---- LangSmith (optional) ----
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medusa-rag
LANGCHAIN_TRACING_V2=false

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://medusa:medusa@postgres:5432/medusa

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# ---- App ----
DEBUG=false
APP_VERSION=1.0.0
